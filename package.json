{
  "name": "type-the-change",
  "displayName": "Type the Change",
  "description": "%description%",
  "version": "0.7.0",
  "publisher": "CodeNyangi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.106.0",
    "node": ">=22"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "ai-assisted-coding",
    "deliberate-practice",
    "code-review",
    "mcp",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNyangi/type-the-change.git"
  },
  "bugs": {
    "url": "https://github.com/CodeNyangi/type-the-change/issues"
  },
  "homepage": "https://github.com/CodeNyangi/type-the-change#readme",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capability.untrustedWorkspaces%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capability.virtualWorkspaces%"
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "typeTheChange.start",
        "title": "%command.start%",
        "shortTitle": "Type the Change",
        "icon": {
          "light": "assets/toolbar-light.svg",
          "dark": "assets/toolbar-dark.svg"
        }
      },
      {
        "command": "typeTheChange.import",
        "title": "%command.import%"
      },
      {
        "command": "typeTheChange.loadPending",
        "title": "%command.loadPending%"
      },
      {
        "command": "typeTheChange.next",
        "title": "%command.next%"
      },
      {
        "command": "typeTheChange.advance",
        "title": "%command.advance%"
      },
      {
        "command": "typeTheChange.runCheck",
        "title": "%command.runCheck%"
      },
      {
        "command": "typeTheChange.chooseCheck",
        "title": "%command.chooseCheck%"
      },
      {
        "command": "typeTheChange.focus",
        "title": "%command.focus%"
      },
      {
        "command": "typeTheChange.stop",
        "title": "%command.stop%"
      },
      {
        "command": "typeTheChange.demo",
        "title": "%command.demo%"
      },
      {
        "command": "typeTheChange.tutorial",
        "title": "%command.tutorial%"
      },
      {
        "command": "typeTheChange.mcpConfig",
        "title": "%command.mcpConfig%"
      },
      {
        "command": "typeTheChange.review",
        "title": "%command.review%"
      },
      {
        "command": "typeTheChange.openFolder",
        "title": "%command.openFolder%"
      },
      {
        "command": "typeTheChange.chooseLanguage",
        "title": "%command.chooseLanguage%"
      },
      {
        "command": "typeTheChange.moveView",
        "title": "%command.moveView%",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "typeTheChange.refreshChats",
        "title": "%command.refreshChats%"
      },
      {
        "command": "typeTheChange.setupLive",
        "title": "%command.setupLive%"
      },
      {
        "command": "typeTheChange.openCodexThread",
        "title": "%command.openCodexThread%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "typeTheChange.start",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        }
      ],
      "view/title": [
        {
          "command": "typeTheChange.moveView",
          "when": "view == typeTheChange.launcher",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typeTheChange.start",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "!typeTheChange.active"
      },
      {
        "command": "typeTheChange.advance",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "typeTheChange.active"
      },
      {
        "command": "typeTheChange.focus",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "typeTheChange.active"
      }
    ],
    "problemMatchers": [
      {
        "name": "type-the-change",
        "owner": "type-the-change-demo",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (error|warning) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "typeTheChange",
          "title": "Type the Change",
          "icon": "assets/toolbar-light.svg"
        }
      ]
    },
    "views": {
      "typeTheChange": [
        {
          "id": "typeTheChange.launcher",
          "name": "Type the Change",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Type the Change",
      "properties": {
        "typeTheChange.language": {
          "type": "string",
          "enum": [
            "auto",
            "ko",
            "en"
          ],
          "enumDescriptions": [
            "%language.auto%",
            "한국어",
            "English"
          ],
          "default": "auto",
          "description": "%language.description%"
        },
        "typeTheChange.codexPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%codexPath.description%"
        },
        "typeTheChange.codexSocket": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%codexSocket.description%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:host": "node scripts/test-host.mjs",
    "test:ui:vscode": "node scripts/test-vscode-ui.mjs",
    "test:ui:webview": "node --import tsx scripts/test-webview-headless.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "vscode:prepublish": "npm run build",
    "preview": "node --import tsx scripts/preview.ts"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "icon": "assets/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#f5f2e9",
    "theme": "light"
  }
}
