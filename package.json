{
  "name": "type-the-change",
  "displayName": "Type the Change",
  "description": "Practice judgment with AI code. Predict, check, and decide.",
  "version": "0.4.0",
  "publisher": "CodeNyangi",
  "license": "MIT",
  "type": "module",
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "ai-assisted-coding",
    "deliberate-practice",
    "code-review",
    "mcp",
    "chatgpt"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeNyangi/type-the-change.git"
  },
  "bugs": {
    "url": "https://github.com/CodeNyangi/type-the-change/issues"
  },
  "homepage": "https://github.com/CodeNyangi/type-the-change#readme",
  "main": "./dist/extension.cjs",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Reads selected source files and prepares local typing guidance."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "This preview uses local files and a loopback sign-in callback."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "typeTheChange.start",
        "title": "Type the Change: Start",
        "shortTitle": "Type the Change",
        "icon": {
          "light": "assets/toolbar-light.svg",
          "dark": "assets/toolbar-dark.svg"
        }
      },
      {
        "command": "typeTheChange.generate",
        "title": "Type the Change: Plan a Change with ChatGPT"
      },
      {
        "command": "typeTheChange.signIn",
        "title": "Type the Change: Continue with ChatGPT"
      },
      {
        "command": "typeTheChange.signOut",
        "title": "Type the Change: Sign Out"
      },
      {
        "command": "typeTheChange.import",
        "title": "Type the Change: Open a Plan"
      },
      {
        "command": "typeTheChange.loadPending",
        "title": "Type the Change: Open MCP Plan"
      },
      {
        "command": "typeTheChange.next",
        "title": "Type the Change: Compare Without Running a Check"
      },
      {
        "command": "typeTheChange.advance",
        "title": "Type the Change: Next Action"
      },
      {
        "command": "typeTheChange.runCheck",
        "title": "Type the Change: Save and Check"
      },
      {
        "command": "typeTheChange.chooseCheck",
        "title": "Type the Change: Select Check Task"
      },
      {
        "command": "typeTheChange.focus",
        "title": "Type the Change: Go to Change"
      },
      {
        "command": "typeTheChange.stop",
        "title": "Type the Change: End Session"
      },
      {
        "command": "typeTheChange.demo",
        "title": "Type the Change: Try the Demo"
      },
      {
        "command": "typeTheChange.tutorial",
        "title": "Type the Change: Watch the Walkthrough"
      },
      {
        "command": "typeTheChange.mcpConfig",
        "title": "Type the Change: Show MCP Connection"
      },
      {
        "command": "typeTheChange.chooseFiles",
        "title": "Type the Change: Select Files"
      },
      {
        "command": "typeTheChange.chooseModel",
        "title": "Type the Change: Select Model"
      },
      {
        "command": "typeTheChange.usage",
        "title": "Type the Change: ChatGPT Usage"
      },
      {
        "command": "typeTheChange.review",
        "title": "Type the Change: Review Changes"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "typeTheChange.start",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "typeTheChange.start",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "!typeTheChange.active"
      },
      {
        "command": "typeTheChange.advance",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "typeTheChange.active"
      },
      {
        "command": "typeTheChange.focus",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "typeTheChange.active"
      }
    ],
    "problemMatchers": [
      {
        "name": "type-the-change",
        "owner": "type-the-change-demo",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+): (error|warning) (.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:host": "node scripts/test-host.mjs",
    "test:ui:vscode": "node scripts/test-vscode-ui.mjs",
    "test:ui:webview": "node --import tsx scripts/test-webview-headless.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "vscode:prepublish": "npm run build",
    "preview": "node --import tsx scripts/preview.ts"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "jose": "6.2.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "icon": "assets/icon.png",
  "preview": true,
  "galleryBanner": {
    "color": "#f5f2e9",
    "theme": "light"
  }
}
